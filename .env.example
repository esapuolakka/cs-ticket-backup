# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Set in production only — must match the CloudFront distribution's custom origin
# header value (see infra/lib/ticket-search-stack.ts). Leave empty for local dev.
ORIGIN_VERIFY_SECRET=

# Load fictional demo tickets on startup if the table is empty
SEED_DEMO_DATA=false

# AWS
AWS_REGION=eu-west-1
DYNAMODB_TABLE=cs-tickets
# For local DynamoDB (docker run -p 8000:8000 amazon/dynamodb-local)
DYNAMODB_ENDPOINT=http://localhost:8000

# AWS Cognito (leave empty for local dev — auth will be bypassed)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_CALLBACK_URL=http://localhost:3000/auth/callback

# Zendesk (for one-time import)
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=your-email@example.com
ZENDESK_API_TOKEN=your-zendesk-api-token
